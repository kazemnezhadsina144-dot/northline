{
  "name": "northline",
  "version": "0.1.0",
  "private": true,
  "description": "Non-custodial Base DEX aggregator using the 0x Swap API v2 AllowanceHolder flow.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --port 3410",
    "build": "next build",
    "start": "next start --port 3410",
    "lint": "node scripts/lint-src.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "audit": "npm audit --audit-level=high",
    "probe:quote": "tsx scripts/probe-quote.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "check:bundle": "node scripts/check-bundle-secrets.mjs"
  },
  "dependencies": {
    "next": "^15.5.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.37.8"
  },
  "overrides": {
    "postcss": "8.5.31",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.17.2",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
