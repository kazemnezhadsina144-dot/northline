# Server only. Never prefix this with NEXT_PUBLIC_.
ZEROX_API_KEY=

# Public Base RPC. Do not put a keyed URL in the browser bundle.
BASE_RPC_URL=https://mainnet.base.org

# Live signing stays off unless this is exactly "true".
# Production also requires PRODUCTION_TRADING=true.
TRADING_ENABLED=false
PRODUCTION_TRADING=false
APP_ENV=development

# Firm quotes older than this are rejected. Bounds: 5000–30000.
QUOTE_TTL_MS=15000
ZEROX_TIMEOUT_MS=8000
